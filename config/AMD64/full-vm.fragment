# 「完整 Linux 虚拟机」基线（x86_64）。
# 这些不是 WSL 补丁，是标准发行版内核本来就该有的东西；WSL 的 config-wsl
# 把它们砍了一批，这里显式补回来（Waydroid / LXC / 桌面 / 网络）。
# 基线已经是 Debian 官方 amd64 config，重复项无害。

# --- 容器 / 命名空间 / cgroup ---
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_PSI=y

# --- binder / Waydroid（bool 项，只能内建） ---
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- 文件系统 / 块设备 ---
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_BTRFS_FS=m
CONFIG_SQUASHFS=m

# --- 容器网络与 NAT ---
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_DUMMY=m
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m

# --- 显示 / 内存类型（x86 专属：MTRR/PAT 缺了会导致 GPU-PV 的映射走错内存属性） ---
CONFIG_DRM=y
CONFIG_DRM_VGEM=m
CONFIG_DRM_HYPERV=m
CONFIG_MTRR=y
CONFIG_X86_PAT=y

# --- 嵌套虚拟化 / 半虚拟 I/O ---
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_SCSI_VIRTIO=m
CONFIG_VIRTIO_BALLOON=m

# --- 杂项诊断 ---
CONFIG_TASKSTATS=y
CONFIG_INET_RAW_DIAG=m
CONFIG_MAC80211_HWSIM=m
