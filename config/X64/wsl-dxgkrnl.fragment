# 微软 GPU-PV 的来宾侧内核支持（x86_64）
# CONFIG_DXGKRNL depends on HYPERV + (64BIT || COMPILE_TEST)，x86_64 天然满足。
# x86 与 arm64 的关键差别：这里不需要补架构层。上游 6.18 的 x86 Hyper-V 一直是完整的
# （drivers/hv、arch/x86/hyperv、hyperv_timer 全在主线），微软只在 drivers/hv 里加了
# dxgkrnl，另外动了 mshyperv.c 与 hyperv_timer.c 两个文件。
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_TIMER=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_DXGKRNL=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y

# x86 侧 UEFI 引导：Debian amd64 内核是 bzImage（自带 EFI stub），保持不变即可
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# 内建 =y：不用 DKMS、不用 MOK，发行版滚内核时也不用重编模块
