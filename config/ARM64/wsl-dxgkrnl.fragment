# 微软 GPU-PV 的来宾侧内核支持（arm64）
# CONFIG_DXGKRNL depends on HYPERV + (64BIT || COMPILE_TEST)，arm64 天然满足。
# 上游 6.18 起 CONFIG_HYPERV 已支持 ARM64（drivers/hv/Kconfig 里
#   depends on (X86 && X86_LOCAL_APIC && HYPERVISOR_GUEST) || (ARM64 && !CPU_BIG_ENDIAN)），
# arch/arm64/hyperv/ 也在 6.18 进了主线；这里只需要搬 dxgkrnl 本体与接线。
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
# 注意：6.18 里 CONFIG_HYPERV_TIMER 是 def_bool HYPERV && X86，arm64 上没有这个符号
# （时间源走 arch timer），所以这里不写，写了也只会被 olddefconfig 丢掉。
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_DXGKRNL=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y

# Hyper-V on ARM64 只支持 4K pages（VMBus 共享页按 4K 对齐）。
# Debian 官方 arm64 内核本来就是 4K，这里钉死防止基线漂移。
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set

# 标准 UEFI 引导：arm64 没有压缩 zImage，Image 本身就是 PE/COFF + EFI stub
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# 内建 =y：不用 DKMS、不用 MOK，testing 滚内核不用重编模块
